{
	"$schema": "https://app.kilo.ai/config.json",
	"mcp": {
		"obsidian": {
			"type": "remote",
			"url": "{env:OBSIDIAN_MCP_URI}",
			"headers": {
				"Authorization": "Bearer {env:OBSIDIAN_MCP_KEY}"
			},
			"oauth": false,
			"enabled": true
		},
		"libreoffice": {
			"type": "remote",
			"url": "{env:LIBREOFFICE_MCP_URI}",
			"enabled": true
		},
		"penpot": {
			"type": "remote",
			"url": "{env:PENPOT_MCP_URI}",
			"headers": {
				"Authorization": "Bearer {env:PENPOT_MCP_KEY}"
			},
			"oauth": false,
			"enabled": true
		}
	},
	"permission": {
		"read": { "*": "allow" },
		"edit": {
			"*": "allow"
		},
		"bash": {
			"*": "allow"
		}
	},
	"instructions": [
		".kilocode/rules/libreoffice.md",
		".kilocode/rules/obsidian.md",
		".kilocode/rules/structure.md",
		".kilocode/rules/variable.md",
		".kilocode/rules/env_example.md",
		".kilocode/rules/git_workflow.md"
	]
}
